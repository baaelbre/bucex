#!/usr/bin/env bash
#PBS -N bucex_uccle_phi
#PBS -l walltime=72:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/phi/uccle/01_txx_stationary.json}"
exec > "logs/11_uccle_phi_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_11_uccle_phi.sh "${CONFIG}" "${PBS_NP:-4}"
