#!/usr/bin/env bash
#PBS -N bucex_sim_pgas
#PBS -l walltime=72:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/simulation.json}"
exec > "logs/04_simulation_pgas_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_04_simulation_pgas.sh "${CONFIG}" "${PBS_NP:-4}"
