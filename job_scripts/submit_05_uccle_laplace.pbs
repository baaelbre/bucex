#!/usr/bin/env bash
#PBS -N bucex_uccle_laplace
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/uccle.json}"
exec > "logs/05_uccle_laplace_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_05_uccle_laplace.sh "${CONFIG}" "${PBS_NP:-4}"
