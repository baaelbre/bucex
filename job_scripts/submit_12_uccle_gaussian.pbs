#!/usr/bin/env bash
#PBS -N bucex_uccle_gaussian
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=32gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/uccle_gaussian/01_txm.json}"
exec > "logs/12_uccle_gaussian_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_12_uccle_gaussian.sh "${CONFIG}" "${PBS_NP:-4}"
