#!/usr/bin/env bash
#PBS -N bx_lmh_fit
#PBS -l walltime=06:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=12gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
source config/laplace_mh_simulation_array.sh

N_TIME="${N_TIME:-1000}"
PERIOD="${PERIOD:-4}"
SIMULATION_SEED="${SIMULATION_SEED:-13081997}"
DRAWS="${DRAWS:-1000}"
WARMUP="${WARMUP:-1000}"
CHAINS="${CHAINS:-4}"
MCMC_SEED="${MCMC_SEED:-13081997}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:?RUN_ID must be passed with qsub -v}"
OVERWRITE="${OVERWRITE:-0}"
MH_STEPS="${MH_STEPS:-1}"
SCENARIO_KEYS="${SCENARIO_KEYS:-${LMH_DEFAULT_SCENARIO_KEYS}}"
TASK_ID="${PBS_ARRAYID:-${PBS_ARRAY_INDEX:-}}"
if [[ -z "${TASK_ID}" ]]; then
  echo "Submit this file as a PBS array; PBS_ARRAYID is missing." >&2
  exit 2
fi

laplace_mh_map_task "${TASK_ID}" "${CHAINS}" "${SCENARIO_KEYS}"
SIGNATURE="$(laplace_mh_run_signature \
  "${N_TIME}" "${PERIOD}" "${DRAWS}" "${WARMUP}" "${CHAINS}" "${MH_STEPS}")"
SHARED_RUN_DIR="$(laplace_mh_run_directory \
  "${RESULTS_ROOT}" "${RUN_ID}" "${SIGNATURE}")"
LOG_DIR="${SHARED_RUN_DIR}/logs/${LMH_TASK_SCENARIO}"
mkdir -p "${LOG_DIR}"
exec > "${LOG_DIR}/chain$(printf '%02d' "${LMH_TASK_CHAIN}")_${PBS_JOBID:-manual}.log" 2>&1

echo "Laplace-MH PBS array task ${TASK_ID}/${LMH_N_TASKS}"
echo "scenario       = ${LMH_TASK_SCENARIO} (${LMH_TASK_SCENARIO_INDEX}/${LMH_N_SCENARIOS})"
echo "chain          = ${LMH_TASK_CHAIN}/${CHAINS}"
echo "shared run dir = ${SHARED_RUN_DIR}"

bash bash_scripts/run_08_simulation_laplace_mh_task.sh \
  "${LMH_TASK_SCENARIO}" "${LMH_TASK_CHAIN}" \
  "${N_TIME}" "${PERIOD}" "${SIMULATION_SEED}" \
  "${DRAWS}" "${WARMUP}" "${CHAINS}" "${MCMC_SEED}" \
  "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}" "${MH_STEPS}" \
  "${LMH_SCENARIO_KEYS}"
