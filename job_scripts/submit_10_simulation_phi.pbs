#!/usr/bin/env bash
#PBS -N bucex_sim_phi
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/phi/simulation_stationary.json}"
exec > "logs/10_simulation_phi_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_10_simulation_phi.sh "${CONFIG}" "${PBS_NP:-4}"
