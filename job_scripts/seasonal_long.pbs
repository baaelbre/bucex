#!/usr/bin/env bash
#PBS -N bx189_final
#PBS -l nodes=1:ppn=4
#PBS -l mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${BUCEX_PROJECT_ROOT:-${PBS_O_WORKDIR:?submit from release root}}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p job_scripts/logs
python_exe="${BUCEX_PYTHON:-python3}"
echo "$(date -u) $(hostname) task=${BUCEX_TASK:?set BUCEX_TASK}"
"$python_exe" -u -m research.seasonal.jobs --group long --task "$BUCEX_TASK"
