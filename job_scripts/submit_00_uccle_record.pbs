#!/usr/bin/env bash
#PBS -N bucex_uccle_record
#PBS -l walltime=01:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/record.json}"
exec > "logs/00_uccle_record_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_00_uccle_record.sh "${CONFIG}" "${PBS_NP:-1}"
