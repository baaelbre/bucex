#!/usr/bin/env bash
#PBS -N bucex_uccle_pgas
#PBS -l walltime=96:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/uccle.json}"
exec > "logs/06_uccle_pgas_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_06_uccle_pgas.sh "${CONFIG}" "${PBS_NP:-4}"
