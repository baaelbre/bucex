#!/usr/bin/env bash
#PBS -N bucex_uccle_laplace_mh
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=2
#PBS -l mem=32gb
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
exec > "logs/09_uccle_laplace_mh_${PBS_JOBID:-manual}.log" 2>&1

bash bash_scripts/run_09_uccle_laplace_mh.sh \
  "${START:-1892-01-01}" "${END:-latest}" "${SERIES:-TXx,TXn,TNx,TNn}" \
  "${DRAWS:-400}" "${WARMUP:-400}" "${CHAINS:-2}" "${SEED:-11010}" \
  "${DATA_DIR:-data}" "${RESULTS_ROOT:-results}" \
  "${RUN_ID:-$(date +%Y%m%d_%H%M%S)}" "${MH_STEPS:-1}"
