#!/usr/bin/env bash
#PBS -N bucex_uccle_laplace_mh
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

START="${START:-1892-01-01}"
END="${END:-latest}"
DRAWS="${DRAWS:-500}"
WARMUP="${WARMUP:-500}"
CHAINS="${CHAINS:-4}"
MCMC_SEED="${MCMC_SEED:-56000}"
DATA_DIR="${DATA_DIR:-data}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
OVERWRITE="${OVERWRITE:-0}"
MH_STEPS="${MH_STEPS:-1}"

exec > "logs/09_uccle_laplace_mh_${PBS_JOBID:-manual}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export BUCEX_MAX_PARALLEL_CHAINS="${PBS_NP:-4}"

echo "Submitting Uccle-Laplace-MH runner"
echo "start       = ${START}"
echo "end         = ${END}"
echo "draws       = ${DRAWS}"
echo "warmup      = ${WARMUP}"
echo "chains      = ${CHAINS}"
echo "PBS cores   = ${PBS_NP:-4}"
echo "MCMC seed   = ${MCMC_SEED}"
echo "MH steps    = ${MH_STEPS}"
echo "data dir    = ${DATA_DIR}"
echo "results     = ${RESULTS_ROOT}"
echo "run id      = ${RUN_ID}"
date
hostname

bash bash_scripts/run_09_uccle_laplace_mh.sh \
  "${START}" "${END}" "${DRAWS}" "${WARMUP}" "${CHAINS}" "${MCMC_SEED}" \
  "${DATA_DIR}" "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}" "${MH_STEPS}"

