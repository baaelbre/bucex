#!/usr/bin/env bash
#PBS -N bucex_centered_ig
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

N_TIME="${N_TIME:-1000}"
SIMULATION_SEED="${SIMULATION_SEED:-13081997}"
DRAWS="${DRAWS:-1000}"
WARMUP="${WARMUP:-1000}"
CHAINS="${CHAINS:-4}"
PARTICLES="${PARTICLES:-256}"
export BUCEX_ENGINE="${ENGINE:-${BUCEX_ENGINE:-laplace}}"
MCMC_SEED="${MCMC_SEED:-13081997}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
OVERWRITE="${OVERWRITE:-0}"

# Friendly qsub names are mapped to the exact names read by the Python file.
export BUCEX_RANDOM_WALK_SD="${RANDOM_WALK_SD:-${BUCEX_RANDOM_WALK_SD:-0.05}}"
export BUCEX_LEVEL_IG_A="${LEVEL_IG_A:-${BUCEX_LEVEL_IG_A:-2.0}}"
export BUCEX_LEVEL_IG_B="${LEVEL_IG_B:-${BUCEX_LEVEL_IG_B:-0.0025}}"
export BUCEX_SIGMA_IG_A="${SIGMA_IG_A:-${BUCEX_SIGMA_IG_A:-2.0}}"
export BUCEX_SIGMA_IG_B="${SIGMA_IG_B:-${BUCEX_SIGMA_IG_B:-2.25}}"
export BUCEX_XI_PRIOR_MEAN="${XI_PRIOR_MEAN:-${BUCEX_XI_PRIOR_MEAN:-0.0}}"
export BUCEX_XI_PRIOR_SD="${XI_PRIOR_SD:-${BUCEX_XI_PRIOR_SD:-0.20}}"

exec > "logs/07_centered_ig_${PBS_JOBID:-manual}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export BUCEX_MAX_PARALLEL_CHAINS="${PBS_NP:-4}"

echo "Submitting centered/IG random-walk GEV runner"
echo "n time      = ${N_TIME}"
echo "sim seed    = ${SIMULATION_SEED}"
echo "draws       = ${DRAWS}"
echo "warmup      = ${WARMUP}"
echo "chains      = ${CHAINS}"
echo "engine      = ${BUCEX_ENGINE}"
if [[ "${BUCEX_ENGINE}" == "pgas" ]]; then
  echo "particles   = ${PARTICLES}"
elif [[ "${BUCEX_ENGINE}" == "laplace_mh" ]]; then
  echo "MH steps    = ${BUCEX_LAPLACE_MH_STEPS:-1}"
fi
echo "PBS cores   = ${PBS_NP:-4}"
echo "MCMC seed   = ${MCMC_SEED}"
echo "RW truth SD = ${BUCEX_RANDOM_WALK_SD}"
echo "level IG    = a=${BUCEX_LEVEL_IG_A}, b=${BUCEX_LEVEL_IG_B}"
echo "results     = ${RESULTS_ROOT}"
echo "run id      = ${RUN_ID}"
date
hostname

bash bash_scripts/run_07_centered_ig.sh \
  "${N_TIME}" "${SIMULATION_SEED}" "${DRAWS}" "${WARMUP}" \
  "${CHAINS}" "${PARTICLES}" "${MCMC_SEED}" \
  "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}"
