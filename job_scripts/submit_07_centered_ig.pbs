#!/usr/bin/env bash
#PBS -N bucex_centered_ig
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/centered_ig.json}"
exec > "logs/07_centered_ig_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_07_centered_ig.sh "${CONFIG}" "${PBS_NP:-4}"
