#!/usr/bin/env bash
#PBS -N bucex_tail_sim
#PBS -l walltime=01:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/tail.json}"
exec > "logs/01_tail_simulations_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_01_tail_simulations.sh "${CONFIG}" "${PBS_NP:-1}"
