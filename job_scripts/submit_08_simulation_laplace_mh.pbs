#!/usr/bin/env bash
# Compatibility single-node runner. For the final simulation study use
# bash_scripts/qsub_08_simulation_laplace_mh.sh, which fans out scenarios and
# chains across a PBS array.
#PBS -N bucex_sim_laplace_mh
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

N_TIME="${N_TIME:-1000}"
PERIOD="${PERIOD:-4}"
SIMULATION_SEED="${SIMULATION_SEED:-13081997}"
DRAWS="${DRAWS:-1000}"
WARMUP="${WARMUP:-1000}"
CHAINS="${CHAINS:-4}"
MCMC_SEED="${MCMC_SEED:-13081997}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
OVERWRITE="${OVERWRITE:-0}"
MH_STEPS="${MH_STEPS:-1}"

exec > "logs/08_simulation_laplace_mh_${PBS_JOBID:-manual}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export BUCEX_MAX_PARALLEL_CHAINS="${PBS_NP:-4}"

echo "Submitting simulation-Laplace-MH runner"
echo "n time      = ${N_TIME}"
echo "period      = ${PERIOD}"
echo "sim seed    = ${SIMULATION_SEED}"
echo "draws       = ${DRAWS}"
echo "warmup      = ${WARMUP}"
echo "chains      = ${CHAINS}"
echo "PBS cores   = ${PBS_NP:-4}"
echo "MCMC seed   = ${MCMC_SEED}"
echo "MH steps    = ${MH_STEPS}"
echo "results     = ${RESULTS_ROOT}"
echo "run id      = ${RUN_ID}"
date
hostname

bash bash_scripts/run_08_simulation_laplace_mh.sh \
  "${N_TIME}" "${PERIOD}" "${SIMULATION_SEED}" \
  "${DRAWS}" "${WARMUP}" "${CHAINS}" "${MCMC_SEED}" \
  "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}" "${MH_STEPS}"
