#!/usr/bin/env bash
#PBS -N bucex_sim_laplace_mh
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=2
#PBS -l mem=24gb
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
exec > "logs/08_simulation_laplace_mh_${PBS_JOBID:-manual}.log" 2>&1

bash bash_scripts/run_08_simulation_laplace_mh.sh \
  "${N_TIME:-240}" "${DRAWS:-400}" "${WARMUP:-400}" "${CHAINS:-2}" \
  "${SEED:-11001}" "${RESULTS_ROOT:-results}" \
  "${RUN_ID:-$(date +%Y%m%d_%H%M%S)}" "${MH_STEPS:-1}"
