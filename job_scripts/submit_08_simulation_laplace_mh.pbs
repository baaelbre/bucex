#!/usr/bin/env bash
#PBS -N bucex_sim_laplace_mh
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
CONFIG="${CONFIG:-examples/config/simulation.json}"
exec > "logs/08_simulation_laplace_mh_${PBS_JOBID:-manual}.log" 2>&1
bash bash_scripts/run_08_simulation_laplace_mh.sh "${CONFIG}" "${PBS_NP:-4}"
