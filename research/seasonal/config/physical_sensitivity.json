{
  "extends": "main.json",
  "_comment": "Separate single-response analyses; all hyperparameters and initial rates are private to each response.",
  "variants": [
    {
      "name": "reference"
    },
    {
      "name": "half_level",
      "multipliers": {
        "level": 0.5
      }
    },
    {
      "name": "double_level",
      "multipliers": {
        "level": 2.0
      }
    },
    {
      "name": "half_slope",
      "multipliers": {
        "trend": 0.5
      }
    },
    {
      "name": "double_slope",
      "multipliers": {
        "trend": 2.0
      }
    },
    {
      "name": "half_seasonal",
      "multipliers": {
        "season": 0.5
      }
    },
    {
      "name": "double_seasonal",
      "multipliers": {
        "season": 2.0
      }
    },
    {
      "name": "half_initial_slope",
      "initial_slope_multiplier": 0.5
    },
    {
      "name": "double_initial_slope",
      "initial_slope_multiplier": 2.0
    },
    {
      "name": "quarter_seasonal",
      "multipliers": {
        "season": 0.25
      }
    },
    {
      "name": "double_slope_half_seasonal",
      "multipliers": {
        "trend": 2.0,
        "season": 0.5
      }
    },
    {
      "name": "double_slope_quarter_seasonal",
      "multipliers": {
        "trend": 2.0,
        "season": 0.25
      }
    }
  ],
  "assessment": {
    "baseline": "reference"
  },
  "mcmc": {
    "warmup": 2000,
    "draws": 4000,
    "chains": 4,
    "chain_workers": 4
  },
  "validation": {
    "training_ends": [
      "2015-11",
      "2020-11"
    ],
    "horizon": 20,
    "draws": 4000,
    "save_fits": true
  },
  "output": "results/serra_192_physical_sensitivity"
}
