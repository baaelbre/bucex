{
  "extends": "main.json",
  "_comment": "Half/double each median-absolute anchor independently around the 1.9.0 wide reference. Other anchors and log-SD stay fixed.",
  "variants": [
    {
      "name": "reference"
    },
    {
      "name": "half_level",
      "multipliers": {
        "level": 0.5
      }
    },
    {
      "name": "double_level",
      "multipliers": {
        "level": 2.0
      }
    },
    {
      "name": "half_slope",
      "multipliers": {
        "trend": 0.5
      }
    },
    {
      "name": "double_slope",
      "multipliers": {
        "trend": 2.0
      }
    },
    {
      "name": "half_seasonal",
      "multipliers": {
        "season": 0.5
      }
    },
    {
      "name": "double_seasonal",
      "multipliers": {
        "season": 2.0
      }
    },
    {
      "name": "half_initial_slope",
      "initial_slope_multiplier": 0.5
    },
    {
      "name": "double_initial_slope",
      "initial_slope_multiplier": 2.0
    }
  ],
  "assessment": {
    "baseline": "reference"
  },
  "mcmc": {
    "warmup": 2000,
    "draws": 4000,
    "chains": 4,
    "chain_workers": 4
  },
  "validation": {
    "training_ends": [
      "2015-11",
      "2020-11"
    ],
    "horizon": 20,
    "draws": 4000,
    "save_fits": true
  },
  "output": "results/serra_190_physical_sensitivity"
}
