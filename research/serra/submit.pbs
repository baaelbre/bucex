#!/usr/bin/env bash
#PBS -N bucex-serra
#PBS -l nodes=1:ppn=1
#PBS -l walltime=24:00:00
#PBS -l mem=16gb
set -euo pipefail
: "${PBS_O_WORKDIR:?Submit from the source checkout}"
: "${CONFIG:?Set CONFIG to a research/serra/config JSON path}"
cd "$PBS_O_WORKDIR"
export OPENBLAS_NUM_THREADS=1
# Activate your installed bucex environment in the submission environment.
# MCMC settings live in CONFIG; this wrapper does not modify them.
python -m research.serra.run --config "$CONFIG"
